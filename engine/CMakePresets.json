{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (C++17 with symbols)",
      "description": "Unoptimized debug build with full symbols and tests enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SETTLECORE_BUILD_TESTS": "ON",
        "SETTLECORE_BUILD_BENCHMARKS": "ON",
        "SETTLECORE_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release (-O3 -DNDEBUG)",
      "description": "Maximum optimization build for production cgo linking and 1M-order benchmarks",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "SETTLECORE_BUILD_TESTS": "ON",
        "SETTLECORE_BUILD_BENCHMARKS": "ON",
        "SETTLECORE_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan + UBSan (Sanitizer Suite)",
      "description": "Instrumented build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SETTLECORE_BUILD_TESTS": "ON",
        "SETTLECORE_BUILD_BENCHMARKS": "OFF",
        "SETTLECORE_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

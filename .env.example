# ==============================================================================
# SettleCore Monorepo Environment Configuration
# ==============================================================================

# --- PostgreSQL 18 Double-Entry Ledger ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=settlecore
POSTGRES_PASSWORD=settlecore_local_dev
POSTGRES_DB=settlecore
DATABASE_URL=postgres://settlecore:settlecore_local_dev@localhost:5432/settlecore?sslmode=disable

# --- C++17 Matching Engine & WAL ---
ENGINE_WAL_DIR=/var/lib/settlecore/wal
ENGINE_SNAPSHOT_DIR=/var/lib/settlecore/snapshots
ENGINE_WAL_FSYNC_MODE=buffered
ENGINE_MAX_RESTING_ORDERS=1048576
ENGINE_CIRCUIT_BREAKER_BPS=1000

# --- EVM Indexing, Multi-RPC Pool & EscrowVault Custody ---
EVM_CHAIN_ID=31337
EVM_PRIMARY_RPC_URL=http://localhost:8545
EVM_FALLBACK_RPC_URL=http://localhost:8546
EVM_CONFIRMATIONS_REQUIRED=3
EVM_REORG_WINDOW_BLOCKS=64
ESCROW_VAULT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
USDC_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
WBTC_TOKEN_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
USDT_TOKEN_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# --- Anvil Deterministic Development Keys (DO NOT USE IN PRODUCTION) ---
# Account #0: Deployer / Admin
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Account #1: EIP-712 Hot Withdrawal Signer (Subject to per-tx & OZ RateLimiter daily cap)
HOT_SIGNER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Account #2: EIP-712 Cold Co-Signer (Required above hot threshold)
COLD_SIGNER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# Account #3: Relayer Transaction Submitter
RELAYER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# --- Gateway, Market Maker & Telemetry ---
GATEWAY_HTTP_ADDR=:8080
GATEWAY_METRICS_ADDR=:9091
CHAOS_API_ENABLED=true
MARKET_MAKER_BINANCE_WS=wss://stream.binance.com:9443/ws
MARKET_MAKER_SPREAD_BPS=8
RECONCILER_INTERVAL_SEC=60
MERKLE_SNAPSHOT_INTERVAL_SEC=3600

# --- Next.js 16.4 Trading & Chaos UI ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/v1/ws
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_ESCROW_VAULT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
